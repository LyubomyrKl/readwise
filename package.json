{
  "name": "workbench",
  "version": "0.0.0",
  "private": true,
  "description": "Workbench, a personal toolbox: Next.js web app, NestJS API and Python workers.",
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:web": "turbo run dev --filter=@workbench/web",
    "dev:api": "turbo run dev --filter=@workbench/api",
    "build:web": "turbo run build --filter=@workbench/web",
    "build:api": "turbo run build --filter=@workbench/api",
    "test:e2e": "npm run test:e2e --workspace apps/api",
    "test:workers": "scripts/test-workers.sh",
    "smoke": "scripts/smoke-summary.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,scss,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,scss,yaml,yml}\"",
    "prisma:sync": "bash sync-prisma.sh"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.10.5"
  }
}
