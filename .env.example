# Database
DATABASE_URL=postgresql://username:password@localhost:5432/summarizer_gateway

# JWT Configuration
JWT_ACCESS_SECRET=your-access-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# S3/MinIO Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minio_access_key
S3_SECRET_ACCESS_KEY=minio_secret_key
S3_BOOK_BUCKET_NAME=summarizer-books
S3_BOOK_COVER_BUCKET_NAME=summarizer-book-covers
S3_SUMMARIES_BUCKET_NAME=summarizer-summaries
S3_REGION=us-east-1

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
