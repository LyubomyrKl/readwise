# Copy to .env next to docker-compose.yml. Every container reads from here, nothing is repeated per service.

# Public address Caddy serves. A hostname (workbench.example.com) enables automatic HTTPS; ":80" is plain HTTP.
SITE_ADDRESS=:80

# Postgres
POSTGRES_USER=workbench
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workbench

# MinIO (S3). The buckets books, covers, extractions, summaries, checkpoints are created on start.
MINIO_ROOT_USER=workbench
MINIO_ROOT_PASSWORD=change-me-too

# RabbitMQ
RABBITMQ_USER=workbench
RABBITMQ_PASS=change-me-three

# API
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=
LOG_LEVEL=info
# Who may sign up: first-user (the default: only while there is no account yet, so a public server
# takes no strangers), open, or closed
REGISTRATION=first-user
# on: serve the API description at /api/docs in production too
SWAGGER=off
# Largest accepted upload (a book or a cover) in bytes, 200 MB; the API holds it in memory while storing it
UPLOAD_MAX_FILE_BYTES=209715200
# Passkeys: the host name and origin of SITE_ADDRESS as the browser sees them
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost

# Money tool: the daily jobs in this time zone (recurring movements 06:00, rates 17:15, prices 18:30,
# the snapshot after each quarter end); off stops the schedule (the jobs can still be run from settings)
MONEY_TIMEZONE=Europe/Warsaw
MONEY_SCHEDULER=on
# Feeds, only to point them elsewhere:
# MONEY_ECB_BASE_URL=https://www.ecb.europa.eu/stats/eurofxref
# MONEY_NBP_BASE_URL=https://api.nbp.pl/api
# MONEY_PRICE_FEED_BASE_URL=https://query1.finance.yahoo.com
# Claude's custom connector (claude.ai → Connectors): the public base URL that
# Tailscale Funnel serves (only /api/money/claude, /.well-known/oauth-* and
# /api/money/oauth/{token,register}); approving happens on WEBAUTHN_ORIGIN. Empty: off.
MONEY_CLAUDE_PUBLIC_URL=

# Workers / LLM host (Ollama, started by hand on its own machine; jobs wait for it instead of failing)
OLLAMA_BASE_URL=http://100.64.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q5_k_m
OLLAMA_EMBED_MODEL=bge-m3
PIPELINE_MODE=balanced
WORKER_PREFETCH_COUNT=1
# Jobs: a worker heartbeats every WORKER_HEARTBEAT_SECONDS; the API re-queues a job silent for JOBS_LEASE_SECONDS
WORKER_HEARTBEAT_SECONDS=60
JOBS_LEASE_SECONDS=900

# Optional
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
API_PORT=5173           # loopback-only port for host tools such as scripts/smoke-summary.sh

# Container limits. The defaults suit a 4-8 GB host with at least 2 CPUs; a *_CPUS value above the
# host's CPU count keeps that container from starting. Uncomment to change:
# DB_MEM_LIMIT=1g
# DB_CPUS=2
# API_MEM_LIMIT=1g          # also the one-shot migrate
# API_CPUS=1
# WORKERS_MEM_LIMIT=1536m   # raise for very large scanned PDFs
# WORKERS_CPUS=1
# WEB_MEM_LIMIT=512m
# WEB_CPUS=1
# MINIO_MEM_LIMIT=512m      # also minio-init
# MINIO_CPUS=1
# RABBITMQ_MEM_LIMIT=512m   # idles near 150 MB; its own memory alarm follows the host's RAM, not this
# RABBITMQ_CPUS=1
# CADDY_MEM_LIMIT=256m
# CADDY_CPUS=1
# BACKUP_MEM_LIMIT=512m     # backup and backup-offsite
# BACKUP_CPUS=1

# Nightly database dump (docker compose --profile backup): dumps older than BACKUP_KEEP_DAYS go, but the
# newest BACKUP_KEEP_MIN always stay; the backup container turns unhealthy when the newest verified dump
# is older than BACKUP_MAX_AGE_HOURS.
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MIN=7
BACKUP_MAX_AGE_HOURS=26

# Off-server copy of the dumps (same profile); BACKUP_REMOTE=offsite: switches it on. The rclone remote
# "offsite" must be of type crypt, so the dumps (the whole database) leave the server encrypted;
# offsite.sh refuses any other remote. It wraps the real storage, given inline as an rclone connection
# string, and only these RCLONE_CONFIG_OFFSITE_* variables reach the rclone container. Passwords (the
# two crypt passwords, an SFTP pass) are given obscured: docker run --rm rclone/rclone:1.68.2 obscure '<password>'
# Hetzner Storage Box over SFTP, for example:
#   RCLONE_CONFIG_OFFSITE_TYPE=crypt
#   RCLONE_CONFIG_OFFSITE_REMOTE=:sftp,host=u123456.your-storagebox.de,port=23,user=u123456,pass=<obscured>:workbench-backups
#   RCLONE_CONFIG_OFFSITE_PASSWORD=<obscured encryption password>
#   RCLONE_CONFIG_OFFSITE_PASSWORD2=<obscured second password, the salt>
# or an S3 bucket: RCLONE_CONFIG_OFFSITE_REMOTE=:s3,provider=Other,access_key_id=..,secret_access_key=..,endpoint=..:bucket/workbench
# (quote a value that holds a comma or a colon: key='a:b'). Keep both encryption passwords off this
# server as well: without them no copy can be read.
BACKUP_REMOTE=
BACKUP_OFFSITE_HOUR_UTC=3
