  "info": {
    "title": "Summarizer API",
    "description": "API for the Summarizer Gateway service",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Anna"
          },
          "locale": {
            "type": "string",
            "example": "en-US"
          },
          "timezone": {
            "type": "string",
            "example": "America/New_York"
          },
          "avatarUrl": {
            "type": "string",
            "example": "https://example.com/avatar.jpg"
          }
        }
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "anna@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "S3curePass1"
          },
          "name": {
            "type": "string",
            "example": "Anna"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SafeUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "uuid"
          },
          "email": {
            "type": "string",
            "example": "anna@example.com"
          },
          "name": {
            "type": "object",
            "nullable": true,
            "example": "Anna"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "Tokens": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "jwt..."
          },
          "refreshToken": {
            "type": "string",
            "example": "jwt..."
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ]
      },
      "AuthBundle": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SafeUser"
          },
          "tokens": {
            "$ref": "#/components/schemas/Tokens"
          }
        },
        "required": [
          "user",
          "tokens"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "anna@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "S3curePass1"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "Bearer eyJhbGciOi..."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "MePayload": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "example": "uuid"
          },
          "email": {
            "type": "string",
            "example": "anna@example.com"
          }
        },
        "required": [
          "userId",
          "email"
        ]
      },
      "LogoutResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "success"
        ]
      },
      "CreateBookDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Book title",
            "example": "The Great Gatsby"
          },
          "author": {
            "type": "string",
            "description": "Book author",
            "example": "F. Scott Fitzgerald"
          },
          "description": {
            "type": "string",
            "description": "Book description",
            "example": "A classic American novel"
          },
          "filename": {
            "type": "string",
            "description": "Original filename",
            "example": "book.epub"
          },
          "mime": {
            "type": "string",
            "description": "MIME type of the book file",
            "example": "application/epub+zip"
          },
          "sizeBytes": {
            "type": "number",
            "description": "File size in bytes",
            "example": 2048576,
            "minimum": 1,
            "maximum": 1073741824
          },
          "customCoverFilename": {
            "type": "string",
            "description": "Custom cover filename",
            "example": "cover.jpg"
          },
          "customCoverMime": {
            "type": "string",
            "description": "Custom cover MIME type",
            "example": "image/jpeg"
          },
          "pageCount": {
            "type": "number",
            "description": "Page Number",
            "example": 100,
            "minimum": 1,
            "maximum": 2555
          }
        },
        "required": [
          "title",
          "author",
          "description",
          "filename",
          "mime",
          "sizeBytes"
        ]
      },
      "PresignInfo": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Presigned upload URL"
          },
          "headers": {
            "type": "object",
            "description": "Required headers for upload"
          }
        },
        "required": [
          "url",
          "headers"
        ]
      },
      "PresignResponse": {
        "type": "object",
        "properties": {
          "bookId": {
            "type": "string",
            "description": "Created book ID"
          },
          "storageKey": {
            "type": "string",
            "description": "Storage key for book file"
          },
          "presignUploadInfo": {
            "description": "Presigned upload info for book file",
            "allOf": [
              {
                "$ref": "#/components/schemas/PresignInfo"
              }
            ]
          },
          "customCoverStorageKey": {
            "type": "string",
            "description": "Storage key for custom cover file"
          },
          "customCoverPresignInfo": {
            "description": "Presigned upload info for custom cover",
            "allOf": [
              {
                "$ref": "#/components/schemas/PresignInfo"
              }
            ]
          }
        },
        "required": [
          "bookId",
          "storageKey",
          "presignUploadInfo"
        ]
      },
      "FinalizeCoverDto": {
        "type": "object",
        "properties": {
          "bookId": {
            "type": "string",
            "description": "Book ID to finalize cover for",
            "example": "uuid-here"
          }
        },
        "required": [
          "bookId"
        ]
      },
      "FinalizeBookDto": {
        "type": "object",
        "properties": {
          "bookId": {
            "type": "string",
            "description": "Book ID to finalize",
            "example": "uuid-here"
          }
        },
        "required": [
          "bookId"
        ]
      },
      "FinalizeResponse": {
        "type": "object",
        "properties": {
          "bookId": {
            "type": "string",
            "description": "Book ID"
          },
          "status": {
            "type": "string",
            "description": "Book status after finalization",
            "enum": [
              "ready"
            ]
          }
        },
        "required": [
          "bookId",
          "status"
        ]
      },
      "BookResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "object"
          },
          "author": {
            "type": "string"
          },
          "coverUrl": {
            "type": "string"
          },
          "fileUrl": {
            "type": "string"
          },
          "spentTime": {
            "type": "number"
          },
          "pageCount": {
            "type": "object"
          },
          "pagePassCount": {
            "type": "number"
          },
          "isFinished": {
            "type": "boolean"
          },
          "isFavorite": {
            "type": "boolean"
          },
          "summaryKey": {
            "type": "object"
          },
          "lastAccessed": {
            "type": "object"
          },
          "mime": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "author",
          "fileUrl",
          "spentTime",
          "pagePassCount",
          "isFinished",
          "isFavorite",
          "summaryKey",
          "lastAccessed",
          "mime",
          "sizeBytes",
          "status",
          "notes",
          "highlights",
          "tags",
          "createdAt",
          "updatedAt"
        ]
      },
      "PresignedUploadDto": {
        "type": "object",
