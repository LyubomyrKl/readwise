    "/api/books/{id}/download": {
      "get": {
        "description": "Downloads the book file with support for HTTP Range requests (partial downloads)",
        "operationId": "downloadBook",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Book ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "description": "HTTP Range header for partial downloads",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Book file download started"
          },
          "206": {
            "description": "Partial content (Range request)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Book not found or not ready"
          },
          "416": {
            "description": "Range not satisfiable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Download book file",
        "tags": [
          "books"
        ]
      }
    },
