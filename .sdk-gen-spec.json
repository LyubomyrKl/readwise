                "schema": {
                  "$ref": "#/components/schemas/FinalizeResponse"
                }
              }
            }
          },
          "400": {
            "description": "File validation failed"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Book not found or already finalized"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Finalize book upload",
        "tags": [
          "books"
        ]
      }
    },
