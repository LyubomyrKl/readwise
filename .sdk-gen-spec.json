    "/api/books/presign": {
      "post": {
        "description": "Creates a new book record and returns presigned URLs for uploading both the book file and optional custom cover",
        "operationId": "createBookAndPresign",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Book created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresignResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input data"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create book record and get presigned upload URLs",
        "tags": [
          "books"
        ]
      }
    },
    "/api/books/cover/finalize": {
      "post": {
        "description": "Verifies the uploaded cover file and links it to the book",
        "operationId": "finalizeCover",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinalizeCoverDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cover finalized successfully"
          },
          "400": {
            "description": "Cover file not found in storage"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Book not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Finalize cover upload",
        "tags": [
          "books"
        ]
      }
    },
    "/api/books/finalize": {
      "post": {
        "description": "Verifies uploaded files, calculates hash, and marks book as ready",
        "operationId": "finalizeBook",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
