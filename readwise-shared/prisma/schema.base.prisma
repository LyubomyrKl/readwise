// =====================================================
// SINGLE SOURCE OF TRUTH - Prisma Schema
// =====================================================
// Do NOT edit schemas in gateway or workers directly!
// Edit this file, then run: ./sync-prisma.sh
//
// Schema changes reach the database through Prisma migrations, never db push:
//   cd readwise-gateway && npx prisma migrate dev --name <change>
// =====================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== platform: users and sessions =====

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  books         Book[]
  notes         Note[]
  highlights    Highlight[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===== reader: books, reading progress, summaries =====

model Book {
  id                    String                 @id @default(uuid())
  userId                String
  title                 String
  author                String
  description           String?
  customCoverStorageKey String?
  spentTime             Int                    @default(0)
  pageCount             Int                    @default(0)
  pagePassCount         Int                    @default(0)
  isFinished            Boolean                @default(false)
  isFavorite            Boolean                @default(false)
  mime                  String
  sizeBytes             BigInt
  sha256                String?
  fileStorageKey        String
  status                BookStatus             @default(pending)
  errorMessage          String?
  summaryStorageKey     String?
  extractionStorageKey  String?
  summaryType           SummaryType?
  summarizationStrategy SummarizationStrategy?
  lastAccessed          DateTime               @default(now())
  readingPosition       Json? // { type: 'pdf' | 'epub', page?: number, cfi?: string, percentage?: number }
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes      Note[]
  highlights Highlight[]
}

enum BookStatus {
  pending
  processing
  ready
  error
}

enum SummaryType {
  extractive
  abstractive
}

enum SummarizationStrategy {
  basic
  structured
  two_pass
  chain_of_density
  hybrid
}

model Note {
  id         String      @id @default(cuid())
  userId     String
  bookId     String
  body       String
  anchor     Json?
  isPinned   Boolean     @default(false)
  isArchived Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  highlights Highlight[]
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  book       Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, bookId, createdAt])
}

model Highlight {
  id        String    @id @default(cuid())
  userId    String
  bookId    String
  color     String?
  text      String
  anchor    Json
  noteId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  note      Note?     @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([userId, bookId, createdAt])
}
