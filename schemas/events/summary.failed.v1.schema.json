{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.summarizer.com/events/summary.failed.v1.schema.json",
  "title": "Summary Failed Event v1",
  "description": "Event schema for failed document summarization",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "jobId", "error"],
  "properties": {
    "v": {
      "$ref": "https://schemas.summarizer.com/$defs/common.v1.schema.json#/$defs/version"
    },
    "jobId": {
      "$ref": "https://schemas.summarizer.com/$defs/common.v1.schema.json#/$defs/jobId"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "$ref": "https://schemas.summarizer.com/$defs/common.v1.schema.json#/$defs/errorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Human-readable error message"
        },
        "details": {
          "type": "object",
          "description": "Additional error context (structure varies by error type)"
        }
      }
    }
  },
  "examples": [
    {
      "v": 1,
      "jobId": "job-fail123",
      "error": {
        "code": "DOCUMENT_TOO_LARGE",
        "message": "Document exceeds maximum size limit of 50MB",
        "details": {
          "actualSize": 67108864,
          "maxSize": 52428800
        }
      }
    }
  ]
}