datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ===== book.model.prisma =====
model Book {
  id            String  @id @default(uuid())
  userId        String
  title         String
  author        String
  description   String?
  cover         String?
  spentHours    Int     @default(0)
  pageCount     Int?
  pagePassCount Int     @default(0)
  isFinished    Boolean @default(false)
  isFavorite    Boolean @default(false)

  mime       String
  sizeBytes  BigInt
  sha256     String
  storageKey String
  status     BookStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum BookStatus {
  pending // presigned but not ready
  processing // if later you trigger a pipeline
  ready // some job is done, like OCR
  error // failed during some stage
}

// ===== refresh-token.model.prisma =====
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===== user.model.prisma =====
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  books Book[] // relation to uploaded books
}
