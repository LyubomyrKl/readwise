datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ===== book.model.prisma =====
model Book {
  id                    String  @id @default(uuid())
  userId                String
  title                 String
  author                String
  description           String?
  customCoverStorageKey String?
  spentTime             Int     @default(0)
  pageCount             Int?
  pagePassCount         Int     @default(0)
  isFinished            Boolean @default(false)
  isFavorite            Boolean @default(false)

  mime                 String
  sizeBytes            BigInt
  sha256               String?
  fileStorageKey       String
  status               BookStatus   @default(pending)
  summaryStorageKey    String?
  extractionStorageKey String?
  summaryType          SummaryType?
  lastAccessed         DateTime?    @default(now())
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes       Note[]
  highlights  Highlight[]
  searchItems SearchItem[]
  tags        BookTag[]
}

enum BookStatus {
  pending // presigned but not ready
  processing // if later you trigger a pipeline
  ready // some job is done, like OCR
  error // failed during some stage
}

enum SummaryType {
  extractive
  abstractive
}

model Note {
  id         String      @id @default(cuid())
  userId     String
  bookId     String
  body       String // markdown allowed
  anchor     Json? // selector, see below
  isPinned   Boolean     @default(false)
  isArchived Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  tags       NoteTag[]
  highlights Highlight[]
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  book       Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, bookId, createdAt])
}

model Highlight {
  id        String         @id @default(cuid())
  userId    String
  bookId    String
  color     String? // hex
  text      String // captured exact text
  anchor    Json // selector, see below
  noteId    String? // optional attached note
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  tags      HighlightTag[]
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  note      Note?          @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([userId, bookId, createdAt])
}

// ===== refresh-token.model.prisma =====
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===== search-item.model.prisma =====
model SearchItem {
  id        String          @id @default(cuid())
  userId    String
  bookId    String
  ownerType SearchOwnerType // 'chunk' | 'note' | 'highlight' | 'summary'
  ownerId   String
  text      String
  meta      Json?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([ownerType, ownerId])
  @@index([userId, bookId, ownerType])
  @@map("search_item")
}

enum SearchOwnerType {
  chunk
  note
  highlight
  tag
}

// ===== tags.model.prisma =====
model Tag {
  id          String   @id @default(cuid())
  userId      String
  name        String
  color       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookTags      BookTag[]
  noteTags      NoteTag[]
  highlightTags HighlightTag[]

  @@unique([userId, name])
}

model BookTag {
  bookId    String
  tagId     String
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookId, tagId]) // one tag per book
  @@index([tagId])
}

model NoteTag {
  noteId    String
  tagId     String
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId]) // one tag per note
  @@index([tagId])
}

model HighlightTag {
  highlightId String
  tagId       String
  createdAt   DateTime @default(now())

  highlight Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([highlightId, tagId]) // one tag per highlight
  @@index([tagId])
}

// ===== user.model.prisma =====
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  books       Book[]
  notes       Note[]
  highlights  Highlight[]
  tags        Tag[]
  searchItems SearchItem[]
}
