// AUTO-GENERATED - Do not edit directly!
// Edit: summarizer-shared/prisma/schema.base.prisma
// Then run: ./sync-prisma.sh

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== book.model.prisma =====
model Book {
  id                    String       @id @default(uuid())
  userId                String
  title                 String
  author                String
  description           String?
  customCoverStorageKey String?
  spentTime             Int          @default(0)
  pageCount             Int          @default(0)
  pagePassCount         Int          @default(0)
  isFinished            Boolean      @default(false)
  isFavorite            Boolean      @default(false)
  mime                  String
  sizeBytes             BigInt
  sha256                String?
  fileStorageKey        String
  status                BookStatus   @default(pending)
  summaryStorageKey       String?
  extractionStorageKey    String?
  summaryType             SummaryType?
  summarizationStrategy   SummarizationStrategy?
  lastAccessed            DateTime     @default(now())
  readingPosition       Json?        // { type: 'pdf' | 'epub', page?: number, cfi?: string, percentage?: number }
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes         Note[]
  highlights    Highlight[]
  searchItems   SearchItem[]
  tags          BookTag[]
  learningNotes LearningNote[]
}

enum BookStatus {
  pending
  processing
  ready
  error
}

enum SummaryType {
  extractive
  abstractive
}

enum SummarizationStrategy {
  basic
  structured
  two_pass
  chain_of_density
  hybrid
}

model Note {
  id         String      @id @default(cuid())
  userId     String
  bookId     String
  body       String
  anchor     Json?
  isPinned   Boolean     @default(false)
  isArchived Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  tags       NoteTag[]
  highlights Highlight[]
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  book       Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, bookId, createdAt])
}

model Highlight {
  id        String         @id @default(cuid())
  userId    String
  bookId    String
  color     String?
  text      String
  anchor    Json
  noteId    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  tags      HighlightTag[]
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  note      Note?          @relation(fields: [noteId], references: [id], onDelete: SetNull)
  learningNotes LearningNote[]

  @@index([userId, bookId, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SearchItem {
  id        String          @id @default(cuid())
  userId    String
  bookId    String
  ownerType SearchOwnerType
  ownerId   String
  text      String
  meta      Json?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([ownerType, ownerId])
  @@index([userId, bookId, ownerType])
  @@map("search_item")
}

enum SearchOwnerType {
  chunk
  note
  highlight
  tag
}

model Tag {
  id          String   @id @default(cuid())
  userId      String
  name        String
  color       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookTags      BookTag[]
  noteTags      NoteTag[]
  highlightTags HighlightTag[]

  @@unique([userId, name])
}

model BookTag {
  bookId    String
  tagId     String
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookId, tagId])
  @@index([tagId])
}

model NoteTag {
  noteId    String
  tagId     String
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
}

model HighlightTag {
  highlightId String
  tagId       String
  createdAt   DateTime @default(now())

  highlight Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([highlightId, tagId])
  @@index([tagId])
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  books       Book[]
  notes       Note[]
  highlights  Highlight[]
  tags        Tag[]
  searchItems SearchItem[]

  // Learning system
  learningNotes      LearningNote[]
  learningCards      LearningCard[]
  cardReviews        CardReview[]
  learningSessions   LearningSession[]
  learningStats      UserLearningStats?
  learningSettings   UserLearningSettings?

  // Dictionary system
  dictionaryEntries  DictionaryEntry[]
  semanticGroups     SemanticGroup[]
  synonymGroups      SynonymGroup[]
}

// ===== learning.model.prisma =====

model LearningNote {
  id                  String         @id @default(cuid())
  userId              String
  bookId              String?
  highlightId         String?
  dictionaryEntryId   String?        // Link to dictionary entry
  targetSentence      String         // L2 sentence (required)
  meaning             String         // L1 translation (required)
  targetWord          String         // Focus word/grammar (required)
  notes               String?
  alternativePhrasing String?
  sourceType          NoteSourceType @default(manual)
  isArchived          Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  book            Book?             @relation(fields: [bookId], references: [id], onDelete: SetNull)
  highlight       Highlight?        @relation(fields: [highlightId], references: [id], onDelete: SetNull)
  dictionaryEntry DictionaryEntry?  @relation(fields: [dictionaryEntryId], references: [id], onDelete: SetNull)
  cards           LearningCard[]

  @@index([userId, createdAt])
  @@index([userId, bookId])
  @@index([dictionaryEntryId])
}

enum NoteSourceType {
  manual
  highlight
  ai_generated
  dictionary
}

model LearningCard {
  id                 String    @id @default(cuid())
  userId             String
  noteId             String
  cardType           CardType
  front              String
  back               String
  clozeIndex         Int?
  difficulty         Float     @default(0.3)
  stability          Float     @default(0.4)
  retrievability     Float     @default(1.0)
  state              CardState @default(new)
  dueAt              DateTime  @default(now())
  lastReviewedAt     DateTime?
  lapseCount         Int       @default(0)
  reviewCount        Int       @default(0)
  consecutiveCorrect Int       @default(0)
  avgResponseTime    Float?
  hesitationCount    Int       @default(0)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  note    LearningNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  reviews CardReview[]

  @@unique([noteId, cardType, clozeIndex])
  @@index([userId, state, dueAt])
  @@index([userId, cardType, state])
}

enum CardType {
  recognition
  production
  cloze
  grammar
}

enum CardState {
  new
  learning
  review
  relearning
}

model CardReview {
  id                 String       @id @default(cuid())
  userId             String
  cardId             String
  rating             ReviewRating
  responseTimeMs     Int
  wasHesitant        Boolean      @default(false)
  previousDifficulty Float
  previousStability  Float
  previousState      CardState
  newDifficulty      Float
  newStability       Float
  newInterval        Int
  reviewedAt         DateTime     @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  card LearningCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([cardId, reviewedAt])
}

enum ReviewRating {
  again
  hard
  good
  easy
}

model LearningSession {
  id               String    @id @default(cuid())
  userId           String
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  newCardsStudied  Int       @default(0)
  reviewsCompleted Int       @default(0)
  correctCount     Int       @default(0)
  incorrectCount   Int       @default(0)
  totalTimeMs      Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model UserLearningStats {
  id                 String    @id @default(cuid())
  userId             String    @unique
  totalNotes         Int       @default(0)
  matureCards        Int       @default(0)
  youngCards         Int       @default(0)
  retentionRate      Float     @default(0)
  productionAccuracy Float     @default(0)
  avgResponseTime    Float     @default(0)
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  lastStudyDate      DateTime?
  dailyNewCardLimit  Int       @default(20)
  dailyReviewLimit   Int       @default(200)
  currentLoadScore   Float     @default(0)
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserLearningSettings {
  id                  String  @id @default(cuid())
  userId              String  @unique
  generateRecognition Boolean @default(true)
  generateProduction  Boolean @default(true)
  generateCloze       Boolean @default(true)
  generateGrammar     Boolean @default(false)
  newCardsPerDay      Int     @default(20)
  maxReviewsPerDay    Int     @default(200)
  showResponseTime    Boolean @default(true)
  enforceProduction   Boolean @default(true)
  requireTyping       Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===== dictionary.model.prisma =====

model DictionaryEntry {
  id              String   @id @default(cuid())
  userId          String
  word            String           // The headword
  partOfSpeech    String?          // noun, verb, adj, etc.
  pronunciation   String?          // IPA notation
  definition      String           // Primary definition in L1
  nuance          String?          // Subtle usage notes, register, etc.
  personalExample String           // REQUIRED - user's own sentence
  sourceContext   String?          // Where did you encounter this word?
  tags            String[]         // User-defined tags
  masteryLevel    Int      @default(0) // 0=new, 1=has cards, 2=mature cards
  lastReviewed    DateTime?        // Last time user opened this entry
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  collocations   Collocation[]
  learningNotes  LearningNote[]
  semanticGroups EntrySemanticGroup[]
  synonymGroups  EntrySynonymGroup[]

  @@unique([userId, word])
  @@index([userId, word])
  @@index([userId, masteryLevel])
  @@index([userId, createdAt])
}

model Collocation {
  id          String   @id @default(cuid())
  entryId     String
  phrase      String           // The collocation phrase
  translation String?          // Optional L1 translation
  example     String?          // Example sentence using collocation
  createdAt   DateTime @default(now())

  entry DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

model SemanticGroup {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String?          // For UI display (hex color)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries EntrySemanticGroup[]

  @@unique([userId, name])
  @@index([userId])
}

model EntrySemanticGroup {
  entryId   String
  groupId   String
  createdAt DateTime @default(now())

  entry DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  group SemanticGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([entryId, groupId])
  @@index([groupId])
}

// Synonym groups - for linking words as synonyms
model SynonymGroup {
  id          String   @id @default(cuid())
  userId      String
  name        String?          // Optional name (e.g., "happy words")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries EntrySynonymGroup[]

  @@index([userId])
}

model EntrySynonymGroup {
  entryId   String
  groupId   String
  createdAt DateTime @default(now())

  entry DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  group SynonymGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([entryId, groupId])
  @@index([groupId])
}
