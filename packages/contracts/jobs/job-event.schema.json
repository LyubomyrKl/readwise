{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://workbench.local/contracts/jobs/job-event.schema.json",
  "title": "JobEvent",
  "description": "Progress report from a worker, published to exchange workbench.job-events with routing key job.<event>. The API updates the Job row and calls the owning tool's hook.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "jobId", "event", "at", "workerId"],
  "properties": {
    "v": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "event": { "type": "string", "enum": ["started", "progress", "waiting", "succeeded", "failed", "cancelled"] },
    "at": { "type": "string", "format": "date-time" },
    "workerId": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "stage": { "type": ["string", "null"], "maxLength": 200 },
    "progress": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "reason": { "type": ["string", "null"], "maxLength": 2000, "description": "event = waiting" },
    "result": { "type": ["object", "null"], "description": "event = succeeded" },
    "error": { "type": ["string", "null"], "maxLength": 4000, "description": "event = failed | cancelled" },
    "retryable": { "type": "boolean", "description": "event = failed; default true" }
  }
}
