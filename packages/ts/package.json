{
  "name": "@summarizer/contracts",
  "version": "1.0.0",
  "description": "TypeScript validators and types for Summarizer system contracts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No linting configured yet'"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}