{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.summarizer.com/events/summarize.request.v1.schema.json",
  "title": "Summarize Request Event v1",
  "description": "Event schema for requesting document summarization",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "jobId", "userId", "input", "params"],
  "properties": {
    "v": {
      "$ref": "https://schemas.summarizer.com/$defs/common.v1.schema.json#/$defs/version"
    },
    "jobId": {
      "$ref": "https://schemas.summarizer.com/$defs/common.v1.schema.json#/$defs/jobId"
    },
    "userId": {
      "$ref": "https://schemas.summarizer.com/$defs/common.v1.schema.json#/$defs/userId"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "key", "mime"],
      "properties": {
        "url": {
          "$ref": "https://schemas.summarizer.com/$defs/common.v1.schema.json#/$defs/url"
        },
        "key": {
          "$ref": "https://schemas.summarizer.com/$defs/common.v1.schema.json#/$defs/s3Key"
        },
        "mime": {
          "$ref": "https://schemas.summarizer.com/$defs/common.v1.schema.json#/$defs/mimeType"
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ratio"],
      "properties": {
        "type": {
          "$ref": "https://schemas.summarizer.com/$defs/common.v1.schema.json#/$defs/summaryType"
        },
        "ratio": {
          "$ref": "https://schemas.summarizer.com/$defs/common.v1.schema.json#/$defs/ratio"
        }
      }
    }
  },
  "examples": [
    {
      "v": 1,
      "jobId": "job-abc123def",
      "userId": "user-456",
      "input": {
        "url": "https://example.com/documents/report.pdf",
        "key": "documents/reports/quarterly-report-2024.pdf",
        "mime": "application/pdf"
      },
      "params": {
        "type": "extractive",
        "ratio": 0.3
      }
    }
  ]
}