{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.summarizer.com/$defs/common.v1.schema.json",
  "title": "Common Definitions For Summarizer",
  "description": "Shared type definitions for summarizer schemas",
  "$defs": {
    "jobId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 1,
      "maxLength": 128,
      "description": "Unique identifier for a summarization job"
    },
    "userId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 1,
      "maxLength": 128,
      "description": "Unique identifier for a user"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version number"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048,
      "description": "HTTP or HTTPS URL"
    },
    "s3Key": {
      "type": "string",
      "pattern": "^[^/].*[^/]$",
      "minLength": 1,
      "maxLength": 1024,
      "description": "S3 object key (no leading/trailing slashes)"
    },
    "mimeType": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9][a-z0-9\\-\\+]*$",
      "description": "MIME type identifier"
    },
    "summaryType": {
      "type": "string",
      "enum": ["extractive", "abstractive", "section"],
      "description": "Type of summary to generate"
    },
    "ratio": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 0.5,
      "description": "Summary ratio (0.1 = 10% of original length)"
    },
    "errorCode": {
      "type": "string",
      "pattern": "^[A-Z_]+$",
      "minLength": 1,
      "maxLength": 50,
      "description": "Error code in UPPER_SNAKE_CASE"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    }
  }
}
