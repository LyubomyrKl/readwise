# Running the API directly on your machine (npm run dev:api) against the Docker infrastructure.
# Inside Docker Compose these values come from the root .env; this file is for local development only.
PORT=5173
NODE_ENV=development
LOG_LEVEL=debug

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

DATABASE_URL=postgresql://workbench:change-me@localhost:5432/workbench?schema=public

S3_HOST=localhost
S3_PORT=9000
S3_ACCESS_KEY_ID=workbench
S3_SECRET_ACCESS_KEY=change-me-too
S3_BOOK_BUCKET_NAME=books
S3_BOOK_COVER_BUCKET_NAME=covers
S3_SUMMARIES_BUCKET_NAME=summaries
S3_EXTRACTIONS_BUCKET_NAME=extractions
S3_CHECKPOINTS_BUCKET_NAME=checkpoints
S3_REGION=us-east-1

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=workbench
RABBITMQ_PASS=change-me-three

# Jobs: api | worker | all (consumers + sweep run unless APP_MODE=api)
APP_MODE=all
JOBS_LEASE_SECONDS=900
JOBS_SWEEP_INTERVAL_SECONDS=60
JOBS_MAX_ATTEMPTS=3

# Optional
CORS_ORIGIN=
SENTRY_DSN=
# who may sign up: first-user (default: only while there is no account), open, closed
REGISTRATION=first-user
UPLOAD_MAX_FILE_BYTES=
