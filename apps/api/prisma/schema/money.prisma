// ===== money tool: accounts, double-entry ledger, investments =====
// Every table and enum carries the money_ prefix; models carry Money because
// their plain names (Account, Transaction, Price) are too generic for a shared client.
//
// Rules (docs/money/plan.md, CLAUDE.md):
// - currency amounts are BigInt minor units (amountMinor); asset quantities are Decimal(28,10)
// - a transaction's entries sum to zero per commodity (deferred trigger, money_rules migration)
// - posted transactions and their entries never change (triggers); fixes are corrections
// - a draft carries the proposed movement as JSON and has no entries until it is posted

enum MoneyCommodityKind {
  currency
  asset

  @@map("money_commodity_kind")
}

enum MoneyCostBasisMethod {
  fifo
  average

  @@map("money_cost_basis_method")
}

enum MoneyInstitutionKind {
  bank
  broker
  bond_registry
  lender
  cash

  @@map("money_institution_kind")
}

enum MoneyAccountType {
  bank
  investment
  bonds
  debt
  /// owned by the ledger: income, expense, opening balance, conversion
  system

  @@map("money_account_type")
}

enum MoneySystemRole {
  income
  expense
  opening_balance
  conversion

  @@map("money_system_role")
}

enum MoneyTaxWrapper {
  taxable
  tax_advantaged

  @@map("money_tax_wrapper")
}

enum MoneyValuation {
  manual
  price_feed
  bond_formula

  @@map("money_valuation")
}

enum MoneyCategoryKind {
  income
  expense

  @@map("money_category_kind")
}

enum MoneyTransactionKind {
  opening_balance
  income
  expense
  transfer
  buy
  sell
  investment_income
  fee
  unit_move
  split
  correction

  @@map("money_transaction_kind")
}

enum MoneyTransactionStatus {
  /// counts in balances; it and its entries are immutable
  posted
  /// proposed (by a recurring rule or Claude), awaiting approval; no entries yet
  draft

  @@map("money_transaction_status")
}

enum MoneyRateSource {
  ecb
  nbp
  manual

  @@map("money_rate_source")
}

enum MoneyPriceSource {
  manual
  import
  feed

  @@map("money_price_source")
}

enum MoneyImportBatchStatus {
  /// uploaded; rows parsed and waiting for review
  preview
  committed

  @@map("money_import_batch_status")
}

enum MoneyImportRowStatus {
  /// parsed, not yet mapped to a movement
  pending
  /// mapped and will be imported on commit
  ready
  /// same dedupe hash as a row imported before
  duplicate
  /// looks like a movement already in the ledger (same account, amount, nearby date)
  matched
  imported
  skipped
  error

  @@map("money_import_row_status")
}

enum MoneyTokenScope {
  /// read accounts, movements, positions and views
  read
  /// read, and propose drafts that wait for approval
  draft

  @@map("money_token_scope")
}

enum MoneyLotConsumptionKind {
  sale
  move

  @@map("money_lot_consumption_kind")
}

model MoneySettings {
  userId           String               @id
  baseCurrencyId   String               @default("PLN")
  defaultCostBasis MoneyCostBasisMethod @default(fifo)
  /// ISO 3166-1 alpha-2; decides the tax currency and the central bank rates of the tax report
  taxResidence     String               @default("PL")
  updatedAt        DateTime             @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseCurrency MoneyCommodity @relation(fields: [baseCurrencyId], references: [id])

  @@map("money_settings")
}

/// A currency or an asset. Currencies are seeded (id = ISO 4217 code, userId null);
/// assets get a generated id and belong to a user.
model MoneyCommodity {
  id        String             @id @default(cuid())
  kind      MoneyCommodityKind
  /// ISO code for currencies, ticker for assets
  code      String
  name      String
  /// minor-unit digits for currencies (PLN 2, JPY 0); display digits for assets
  decimals  Int
  userId    String?
  createdAt DateTime           @default(now())

  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset        MoneyAsset?
  quotedAssets MoneyAsset[]        @relation("MoneyAssetQuote")
  subAccounts  MoneySubAccount[]
  settings     MoneySettings[]
  lotCosts     MoneyLot[]          @relation("MoneyLotCostCurrency")
  lotTrades    MoneyLot[]          @relation("MoneyLotTradeCurrency")
  prices       MoneyPrice[]
  ratesFrom    MoneyExchangeRate[] @relation("MoneyRateFrom")
  ratesTo      MoneyExchangeRate[] @relation("MoneyRateTo")
  snapshots    MoneySnapshot[]

  @@index([kind, code])
  @@index([userId])
  @@map("money_commodity")
}

model MoneyAsset {
  commodityId     String         @id
  ticker          String?
  isin            String?
  /// "units", "bonds of 100 PLN", ...
  unitName        String         @default("units")
  quoteCurrencyId String
  valuation       MoneyValuation @default(manual)
  /// price feed: { provider, symbol }; bond formula: see core/bonds.ts
  valuationConfig Json?
  archivedAt      DateTime?
  createdAt       DateTime       @default(now())

  commodity     MoneyCommodity         @relation(fields: [commodityId], references: [id], onDelete: Cascade)
  quoteCurrency MoneyCommodity         @relation("MoneyAssetQuote", fields: [quoteCurrencyId], references: [id])
  classSplits   MoneyAssetClassSplit[]
  lots          MoneyLot[]
  prices        MoneyPrice[]
  transactions  MoneyTransaction[]

  @@map("money_asset")
}

model MoneyAssetClass {
  id        String   @id @default(cuid())
  userId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  splits   MoneyAssetClassSplit[]
  targets  MoneyAllocationTarget[]
  accounts MoneyAccount[]

  @@unique([userId, name])
  @@map("money_asset_class")
}

model MoneyAssetClassSplit {
  assetId String
  classId String
  /// share of the asset in this class, 0..100
  percent Decimal @db.Decimal(7, 4)

  asset MoneyAsset      @relation(fields: [assetId], references: [commodityId], onDelete: Cascade)
  class MoneyAssetClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([assetId, classId])
  @@map("money_asset_class_split")
}

/// Target history; the current target of a class is the row with the latest validFrom.
model MoneyAllocationTarget {
  id        String   @id @default(cuid())
  classId   String
  percent   Decimal  @db.Decimal(7, 4)
  validFrom DateTime @db.Date
  createdAt DateTime @default(now())

  class MoneyAssetClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, validFrom])
  @@map("money_allocation_target")
}

model MoneyInstitution {
  id        String               @id @default(cuid())
  userId    String
  name      String
  kind      MoneyInstitutionKind
  createdAt DateTime             @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts MoneyAccount[]

  @@unique([userId, name])
  @@map("money_institution")
}

model MoneyAccount {
  id              String                @id @default(cuid())
  userId          String
  /// null only for system accounts
  institutionId   String?
  name            String
  type            MoneyAccountType
  systemRole      MoneySystemRole?
  taxWrapper      MoneyTaxWrapper       @default(taxable)
  /// null: use MoneySettings.defaultCostBasis
  costBasisMethod MoneyCostBasisMethod?
  /// the asset class this account's cash counts in (e.g. the emergency fund)
  cashClassId     String?
  /// default statement profile for imports into this account ("mbank", "pko", "zen", "ibkr")
  importProfile   String?
  archivedAt      DateTime?
  createdAt       DateTime              @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution   MoneyInstitution?  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  cashClass     MoneyAssetClass?   @relation(fields: [cashClassId], references: [id], onDelete: SetNull)
  subAccounts   MoneySubAccount[]
  lots          MoneyLot[]
  importBatches MoneyImportBatch[]

  @@unique([userId, systemRole])
  @@index([userId, archivedAt])
  @@map("money_account")
}

/// One per (account, commodity): mBank → PLN, mBank → USD, IBKR → VWCE.
model MoneySubAccount {
  id          String   @id @default(cuid())
  accountId   String
  commodityId String
  /// IBAN or account number of this currency as printed on statements; recognizes transfers between own accounts
  number      String?
  createdAt   DateTime @default(now())

  account   MoneyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  commodity MoneyCommodity @relation(fields: [commodityId], references: [id], onDelete: Cascade)
  entries   MoneyEntry[]

  @@unique([accountId, commodityId])
  @@map("money_sub_account")
}

model MoneyCategory {
  id         String            @id @default(cuid())
  userId     String
  name       String
  kind       MoneyCategoryKind
  parentId   String?
  /// set on the categories the ledger itself uses: fees, taxes, dividends, interest, other_income, other_expense
  key        String?
  archivedAt DateTime?
  createdAt  DateTime          @default(now())

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       MoneyCategory?     @relation("MoneyCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     MoneyCategory[]    @relation("MoneyCategoryTree")
  transactions MoneyTransaction[]
  entries      MoneyEntry[]

  @@unique([userId, key])
  @@index([userId, kind])
  @@map("money_category")
}

model MoneyTransaction {
  id              String                 @id @default(cuid())
  userId          String
  /// the day the money moved
  date            DateTime               @db.Date
  kind            MoneyTransactionKind
  status          MoneyTransactionStatus @default(posted)
  note            String?
  /// main category; each income or expense entry carries its own as well
  categoryId      String?
  /// the asset of a buy, sell, investment income, unit move or split
  assetId         String?
  /// the transaction this one corrects or reverses
  correctsId      String?
  recurringRuleId String?
  importRowId     String?                @unique
  /// for drafts: { kind, input } as the movement endpoints accept it
  draft           Json?
  /// who proposed a draft or posted it: "user", "token:<id>", "recurring:<id>", "import:<batch>"
  proposedBy      String?
  postedAt        DateTime?
  /// set by the database: the database transaction that posted it, the only one that may add its entries (rule 4)
  postedXact      BigInt?
  createdAt       DateTime               @default(now())

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      MoneyCategory?        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  asset         MoneyAsset?           @relation(fields: [assetId], references: [commodityId], onDelete: Cascade)
  corrects      MoneyTransaction?     @relation("MoneyCorrection", fields: [correctsId], references: [id], onDelete: Cascade)
  correctedBy   MoneyTransaction[]    @relation("MoneyCorrection")
  recurringRule MoneyRecurringRule?   @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  importRow     MoneyImportRow?       @relation(fields: [importRowId], references: [id], onDelete: SetNull)
  entries       MoneyEntry[]
  lotsOpened    MoneyLot[]
  consumptions  MoneyLotConsumption[]

  @@index([userId, status, date])
  @@index([correctsId])
  @@index([assetId])
  @@map("money_transaction")
}

/// The only place money lives. Exactly one of amountMinor (currency sub-account)
/// and quantity (asset sub-account) is set; positive = into the sub-account.
model MoneyEntry {
  id            String   @id @default(cuid())
  transactionId String
  subAccountId  String
  amountMinor   BigInt?
  quantity      Decimal? @db.Decimal(28, 10)
  /// the category of an income or expense entry
  categoryId    String?
  createdAt     DateTime @default(now())

  transaction MoneyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  subAccount  MoneySubAccount  @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  category    MoneyCategory?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  lotsOpened  MoneyLot[]

  @@index([transactionId])
  @@index([subAccountId])
  @@index([categoryId])
  @@map("money_entry")
}

/// Opened by every buy (and by unit moves, which carry the cost of the lots they move).
model MoneyLot {
  id                 String    @id @default(cuid())
  accountId          String
  assetId            String
  /// the buy or unit move that opened the lot, and its asset entry
  transactionId      String
  openingEntryId     String
  /// the lot this one was moved from (unit move)
  parentLotId        String?
  units              Decimal   @db.Decimal(28, 10)
  remainingUnits     Decimal   @db.Decimal(28, 10)
  /// all-in cost in the currency actually paid
  costMinor          BigInt
  remainingCostMinor BigInt
  costCurrencyId     String
  /// what the broker charged in the trade currency, when that differs from the currency paid
  tradeCostMinor     BigInt?
  tradeCurrencyId    String?
  /// cost in the tax currency at the central bank rate of the business day before acquisition
  costPlnMinor       BigInt?
  costPlnRate        Decimal?  @db.Decimal(28, 12)
  costPlnRateDate    DateTime? @db.Date
  acquiredAt         DateTime  @db.Date
  reversedAt         DateTime?
  createdAt          DateTime  @default(now())

  account       MoneyAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset         MoneyAsset            @relation(fields: [assetId], references: [commodityId], onDelete: Cascade)
  transaction   MoneyTransaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  openingEntry  MoneyEntry            @relation(fields: [openingEntryId], references: [id], onDelete: Cascade)
  parentLot     MoneyLot?             @relation("MoneyLotMove", fields: [parentLotId], references: [id], onDelete: Cascade)
  childLots     MoneyLot[]            @relation("MoneyLotMove")
  costCurrency  MoneyCommodity        @relation("MoneyLotCostCurrency", fields: [costCurrencyId], references: [id])
  tradeCurrency MoneyCommodity?       @relation("MoneyLotTradeCurrency", fields: [tradeCurrencyId], references: [id])
  consumptions  MoneyLotConsumption[]

  @@index([accountId, assetId, acquiredAt])
  @@index([transactionId])
  @@map("money_lot")
}

/// Units taken out of a lot by a sale or a unit move, with the cost they carry.
model MoneyLotConsumption {
  id                 String                  @id @default(cuid())
  lotId              String
  transactionId      String
  kind               MoneyLotConsumptionKind
  units              Decimal                 @db.Decimal(28, 10)
  /// share of the lot's cost, in the lot's cost currency
  costAllocatedMinor BigInt
  /// set when the sale or move was reversed; the units went back into the lot
  reversedAt         DateTime?
  createdAt          DateTime                @default(now())

  lot         MoneyLot         @relation(fields: [lotId], references: [id], onDelete: Cascade)
  transaction MoneyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@index([transactionId])
  @@map("money_lot_consumption")
}

model MoneyPrice {
  id              String           @id @default(cuid())
  assetId         String
  date            DateTime         @db.Date
  /// price of one unit in the quote currency; a rate, not stored money
  price           Decimal          @db.Decimal(28, 10)
  quoteCurrencyId String
  source          MoneyPriceSource @default(manual)
  createdAt       DateTime         @default(now())

  asset         MoneyAsset     @relation(fields: [assetId], references: [commodityId], onDelete: Cascade)
  quoteCurrency MoneyCommodity @relation(fields: [quoteCurrencyId], references: [id])

  @@unique([assetId, date, source])
  @@index([assetId, date])
  @@map("money_price")
}

/// 1 unit of `from` = rate units of `to`. Display and tax only (rule 5).
model MoneyExchangeRate {
  id        String          @id @default(cuid())
  date      DateTime        @db.Date
  fromId    String
  toId      String
  rate      Decimal         @db.Decimal(28, 12)
  source    MoneyRateSource
  createdAt DateTime        @default(now())

  from MoneyCommodity @relation("MoneyRateFrom", fields: [fromId], references: [id])
  to   MoneyCommodity @relation("MoneyRateTo", fields: [toId], references: [id])

  @@unique([source, date, fromId, toId])
  @@index([fromId, toId, date])
  @@map("money_exchange_rate")
}

model MoneyRecurringRule {
  id        String               @id @default(cuid())
  userId    String
  name      String
  kind      MoneyTransactionKind
  /// the movement each run proposes, as the movement endpoints accept it (date excluded)
  template  Json
  /// RFC 5545 subset, e.g. "FREQ=MONTHLY;BYMONTHDAY=10" (see core/schedule.ts)
  schedule  String
  startDate DateTime             @db.Date
  endDate   DateTime?            @db.Date
  nextRunAt DateTime             @db.Date
  /// post at once instead of creating a draft
  autoPost  Boolean              @default(false)
  pausedAt  DateTime?
  lastRunAt DateTime?
  createdAt DateTime             @default(now())

  user User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs MoneyTransaction[]

  @@index([nextRunAt])
  @@map("money_recurring_rule")
}

/// Net worth and positions frozen at a date (the quarterly checkpoint).
model MoneySnapshot {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date
  label          String?
  baseCurrencyId String
  netWorthMinor  BigInt
  /// accounts, positions with prices and values, allocation (views/net-worth shape)
  data           Json
  createdAt      DateTime @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseCurrency MoneyCommodity @relation(fields: [baseCurrencyId], references: [id])

  @@unique([userId, date])
  @@map("money_snapshot")
}

model MoneyImportBatch {
  id            String                 @id @default(cuid())
  userId        String
  /// "money-manager", "mbank", "pko", "zen", "ibkr", "prices"
  sourceProfile String
  /// the account a statement belongs to (bank and broker profiles)
  accountId     String?
  fileName      String
  fileSha256    String
  encoding      String?
  status        MoneyImportBatchStatus @default(preview)
  /// detected header and the column mapping chosen on the mapping screen
  mapping       Json?
  /// profile options: date format, decimal separator, opening balance targets
  options       Json?
  rowCount      Int                    @default(0)
  committedAt   DateTime?
  createdAt     DateTime               @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account MoneyAccount?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  rows    MoneyImportRow[]

  @@unique([userId, fileSha256])
  @@map("money_import_batch")
}

model MoneyImportRow {
  id                 String               @id @default(cuid())
  batchId            String
  rowNumber          Int
  /// the cells as read from the file
  raw                Json
  /// the movement this row becomes: { kind, input } as the movement endpoints accept it
  proposal           Json?
  /// stable hash of the fields that identify a movement, plus its ordinal among identical rows
  dedupeHash         String?
  status             MoneyImportRowStatus @default(pending)
  message            String?
  /// an existing transaction this row looks like (status matched)
  matchTransactionId String?
  createdAt          DateTime             @default(now())

  batch       MoneyImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  transaction MoneyTransaction?

  @@unique([batchId, rowNumber])
  @@index([dedupeHash])
  @@map("money_import_row")
}

model MoneyApiToken {
  id         String          @id @default(cuid())
  userId     String
  name       String
  scope      MoneyTokenScope @default(read)
  /// sha256 of the token; the token itself is shown once
  tokenHash  String          @unique
  /// first characters, to recognize the token in the list
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("money_api_token")
}

/// A one-time OAuth authorization code for Claude's custom connector: the owner
/// approved in Workbench, Claude trades it (with the PKCE verifier) for a read token.
model MoneyOauthCode {
  id            String    @id @default(cuid())
  userId        String
  /// sha256 of the code; the code itself only travels in the redirect
  codeHash      String    @unique
  clientId      String
  redirectUri   String
  /// PKCE S256 challenge
  codeChallenge String
  scope         String    @default("read")
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("money_oauth_code")
}

model MoneyAuditLog {
  id        String   @id @default(cuid())
  userId    String
  /// "user", "token:<id>", "recurring:<id>", "system"
  actor     String
  /// "transaction.post", "account.archive", ...
  action    String
  subjectId String?
  details   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("money_audit_log")
}
