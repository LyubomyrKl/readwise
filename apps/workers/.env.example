# Running the workers directly on your machine (python main.py) against the Docker infrastructure.
# Inside Docker Compose these values come from the root .env; this file is for local development only.
DATABASE_URL=postgresql://workbench:change-me@localhost:5432/workbench?schema=public

S3_HOST=localhost
S3_PORT=9000
S3_ACCESS_KEY_ID=workbench
S3_SECRET_ACCESS_KEY=change-me-too

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=workbench
RABBITMQ_PASS=change-me-three
RABBITMQ_HEARTBEAT=0

# LLM host (Ollama); summarization waits on this machine being reachable
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q5_k_m
OLLAMA_EMBED_MODEL=bge-m3

PIPELINE_MODE=balanced
WORKER_ID=worker
WORKER_PREFETCH_COUNT=1
