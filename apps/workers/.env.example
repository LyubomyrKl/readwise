# Running the workers directly on your machine (python -m worker) against the Docker infrastructure.
# Inside Docker Compose these values come from the root .env; this file is for local development only.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=workbench
RABBITMQ_PASS=change-me-three

S3_HOST=localhost
S3_PORT=9000
S3_ACCESS_KEY_ID=workbench
S3_SECRET_ACCESS_KEY=change-me-too
S3_BOOK_BUCKET_NAME=books
S3_EXTRACTIONS_BUCKET_NAME=extractions
S3_SUMMARIES_BUCKET_NAME=summaries
S3_CHECKPOINTS_BUCKET_NAME=checkpoints

# LLM host (Ollama, started by hand); jobs wait for it instead of failing
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q5_k_m
OLLAMA_EMBED_MODEL=bge-m3
PIPELINE_MODE=balanced

WORKER_ID=workers-local
WORKER_QUEUES=reader
WORKER_PREFETCH_COUNT=1
WORKER_HEARTBEAT_SECONDS=60
LOG_LEVEL=INFO
