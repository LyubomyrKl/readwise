model Book {
  id             String   @id @default(uuid())
  userId         String
  title          String
  author         String
  description    String?
  customCoverStorageKey    String?
  customCoverSizeBytes    BigInt?
  spentHours     Int      @default(0)
  pageCount      Int?
  pagePassCount  Int      @default(0)
  isFinished     Boolean  @default(false)
  isFavorite     Boolean  @default(false)

  mime           String
  sizeBytes      BigInt
  sha256         String?
  fileStorageKey     String
  status         BookStatus @default(pending)
  
  lastAccessed   DateTime? @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


enum BookStatus {
  pending     // presigned but not ready
  processing  // if later you trigger a pipeline
  ready       // some job is done, like OCR
  error       // failed during some stage
}
